# Lấy 2 giá trị này ở Supabase > Project Settings > API.
# Để trống thì web chạy ở "chế độ thử" (dữ liệu lưu trong trình duyệt).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# ===== Phần Nền tảng (nhắc việc, Telegram). Các biến dưới đây chỉ đặt trên Vercel, KHÔNG có NEXT_PUBLIC_ (trừ tên bot) =====

# Khóa bí mật của Supabase. Lấy ở: Supabase > Project Settings > API > "service_role" (bấm Reveal). TUYỆT ĐỐI không công khai.
SUPABASE_SERVICE_ROLE_KEY=

# Chuỗi bí mật tự đặt (ví dụ 30+ ký tự ngẫu nhiên). Supabase dùng nó để gọi /api/cron/nhac. Phải giống giá trị cron_secret trong bảng app_config.
CRON_SECRET=

# Email nhắc việc qua Gmail: GMAIL_USER là địa chỉ Gmail gửi thư; GMAIL_APP_PASSWORD là "mật khẩu ứng dụng" 16 ký tự
# (myaccount.google.com > Bảo mật > bật Xác minh 2 bước > Mật khẩu ứng dụng).
GMAIL_USER=
GMAIL_APP_PASSWORD=

# Bot Telegram. Token lấy từ @BotFather sau lệnh /newbot.
TELEGRAM_BOT_TOKEN=
# Chuỗi bí mật tự đặt (chỉ chữ, số, gạch dưới, gạch ngang), Telegram gửi kèm mỗi tin để web biết là thật.
TELEGRAM_WEBHOOK_SECRET=
# Tên đăng nhập của bot, không có dấu @ (BotFather đã cho, kết thúc bằng "bot").
NEXT_PUBLIC_TELEGRAM_BOT_NAME=

# (Tùy chọn) Địa chỉ web, chỉ cần nếu muốn cố định. Mặc định web tự nhận.
SITE_URL=

# (Tùy chọn, mặc định TẮT) AI dự phòng đọc ngày giờ khi bộ đọc theo mẫu bó tay. Khóa miễn phí ở aistudio.google.com/apikey. Tối đa 20 lần/người/ngày.
GEMINI_API_KEY=
